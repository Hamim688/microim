datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum InquiryStatus {
  NEW
  REVIEWING
  QUOTATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  OTHER
}

enum StockMovementType {
  INITIAL
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Decimal     @db.Decimal(10, 2)
  costPrice   Decimal     @default(0) @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String?
  specs       Json?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  stockMovements StockMovement[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  customerName    String        @default("Pelanggan")
  customerContact String?
  paymentMethod   PaymentMethod @default(CASH)
  note            String?       @db.Text
  stockMovements  StockMovement[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderItemType {
  COMPONENT
  SERVICE
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Komponen: wajib terisi & mengurangi stok. Jasa: kosong.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  itemType  OrderItemType @default(COMPONENT)
  /// Nama jasa (untuk item jenis Jasa).
  name      String?
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal  @default(0) @db.Decimal(10, 2)
}

model Project {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  category    String
  summary     String
  problem     String?        @db.Text
  solution    String?        @db.Text
  result      String?        @db.Text
  techStack   String[]
  images      ProjectImage[]
  featured    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProjectInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  whatsapp    String
  projectType String
  budget      String?
  description String        @db.Text
  timeline    String?
  fileUrl     String?
  status      InquiryStatus @default(NEW)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  tagline     String
  description String   @db.Text
  features    String[]
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Riwayat setiap perubahan stok: stok awal, restock, penjualan, pengembalian, koreksi.
model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  change    Int
  stockAfter Int
  note      String?
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
}

/// Foto produk yang diunggah dari panel admin (disimpan di database agar jalan di Vercel tanpa layanan tambahan).
model ProductImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

/// Kunjungan halaman situs publik (untuk grafik pengunjung di dashboard admin). Tanpa data pribadi:
/// visitorId hanya kode acak dari cookie peramban.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

/// Pengaturan sederhana panel admin (mis. batas stok menipis).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
